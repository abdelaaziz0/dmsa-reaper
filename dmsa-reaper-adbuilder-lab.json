      "aclEdges": [
        {
          "id": "direct-create-delete-dmsa",
          "description": "Direct object-specific create plus cleanup authority",
          "trustee": "DMSALAB\\Reaper-Direct",
          "target": "OU=DMSA-Direct,OU=Lab",
          "rights": [
            "CreateChild",
            "DeleteChild"
          ],
          "objectType": "msDS-DelegatedManagedServiceAccount",
          "inheritance": "None",
          "accessType": "Allow",
          "labUnsafe": true
        },
        {
          "id": "direct-target-link",
          "trustee": "DMSALAB\\Reaper-Direct",
          "target": "CN=victim.direct,OU=Targets,OU=Lab,DC=dmsalab,DC=local",
          "rights": [
            "WriteProperty"
          ],
          "objectType": "msDS-SupersededManagedAccountLink",
          "inheritance": "None",
          "accessType": "Allow",
          "labUnsafe": true
        },
        {
          "id": "direct-target-state",
          "trustee": "DMSALAB\\Reaper-Direct",
          "target": "CN=victim.direct,OU=Targets,OU=Lab,DC=dmsalab,DC=local",
          "rights": [
            "WriteProperty"
          ],
