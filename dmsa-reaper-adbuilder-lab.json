{
  "metadata": {
    "configVersion": "0.5",
    "description": "Disposable Windows Server 2025 AD lab for every retained dMSA-Reaper engagement primitive: direct post-patch and legacy creation, existing-dMSA control, container-DACL escalation, target-DACL escalation, nested and primary-group token expansion, cleanup authority, and negative ACL controls. Requires ADBuilder -LabUnsafe.",
    "author": "dMSA-Reaper"
  },
  "mode": "newForest",
  "execution": {
    "labMode": true,
    "reconcile": {
      "global": {
        "default": "additive"
      },
      "perType": {
        "users": {
          "mode": "update",
          "allowMove": false,
          "allowPasswordReset": false
        },
        "groups": {
          "mode": "additive",
          "allowDelete": false
        },
        "memberships": {
          "mode": "additive",
          "allowDelete": false
        },
        "ous": {
          "mode": "additive",
          "allowDelete": false
        }
      }
    }
  },
  "forest": {
    "domainName": "dmsalab.local",
    "netbiosName": "DMSALAB",
    "forestMode": "WinThreshold",
    "domainMode": "WinThreshold",
    "installDns": true,
    "databasePath": "C:\\Windows\\NTDS",
    "logPath": "C:\\Windows\\NTDS",
    "sysvolPath": "C:\\Windows\\SYSVOL",
    "dsrmPassword": {
      "source": "env",
      "name": "ADBUILDER_DSRM_PASSWORD"
    }
  },
  "providers": {
    "directory": {
      "enabled": true,
      "ous": [
        {
          "name": "Lab",
          "description": "Isolated dMSA-Reaper engagement lab boundary",
          "protectFromDeletion": true,
          "children": [
            {
              "name": "Operators",
              "description": "Low-privilege identities used to run dMSA-Reaper"
            },
            {
              "name": "Groups",
              "description": "Operator role and PAC signal groups"
            },
            {
              "name": "Targets",
              "description": "Disposable migration target accounts"
            },
            {
              "name": "NegativeControls",
              "description": "Objects that must not classify as executable paths"
            },
            {
              "name": "DMSA-Direct",
              "description": "Direct object-specific dMSA create and delete authority"
            },
            {
              "name": "DMSA-Legacy",
              "description": "Legacy one-way path with no target-side write authority"
            },
            {
              "name": "DMSA-Nested",
              "description": "Rights inherited through a nested security group"
            },
            {
              "name": "DMSA-PrimaryGroup",
              "description": "Rights granted through the Domain Users primary group"
            },
            {
              "name": "DMSA-DACL-Container",
              "description": "WriteDacl-only container escalation fixture"
            },
            {
              "name": "DMSA-DACL-Target",
              "description": "Direct dMSA creation side of the target-DACL fixture"
            },
            {
              "name": "ExistingDMSA",
              "description": "Pre-created dMSA with both migration attributes writable"
            },
            {
              "name": "ExistingDMSA-Partial",
              "description": "Pre-created dMSA with only one migration attribute writable"
            },
            {
              "name": "DMSA-GenericWriteOnly",
              "description": "Negative control: GenericWrite is not CreateChild"
            },
            {
              "name": "DMSA-WrongClass",
              "description": "Negative control: CreateChild is scoped to user, not dMSA"
            },
            {
              "name": "DMSA-Deny",
              "description": "Negative control: explicit dMSA CreateChild deny"
            },
            {
              "name": "DMSA-WriteOwnerOnly",
              "description": "Negative control: WriteOwner is not an executable DACL path"
            }
          ]
        }
      ],
      "groups": [
        {
          "name": "Reaper-Direct",
          "ou": "OU=Groups,OU=Lab",
          "scope": "Global",
          "category": "Security",
          "description": "Direct post-patch mutual-pair operator"
        },
        {
          "name": "Reaper-Legacy",
          "ou": "OU=Groups,OU=Lab",
          "scope": "Global",
          "category": "Security",
          "description": "Legacy one-way operator"
        },
        {
          "name": "Reaper-Existing",
          "ou": "OU=Groups,OU=Lab",
          "scope": "Global",
          "category": "Security",
          "description": "Existing-dMSA operator with both dMSA-side writes"
        },
        {
          "name": "Reaper-Existing-P",
          "ou": "OU=Groups,OU=Lab",
          "scope": "Global",
          "category": "Security",
          "description": "Negative existing-dMSA operator with one dMSA-side write"
        },
        {
          "name": "Reaper-DACL-OU",
          "ou": "OU=Groups,OU=Lab",
          "scope": "Global",
          "category": "Security",
          "description": "Container WriteDacl escalation operator"
        },
        {
