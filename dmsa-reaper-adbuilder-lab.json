          "rights": [
            "WriteProperty"
          ],
          "objectType": "msDS-ManagedAccountPrecededByLink",
          "inheritedObjectType": "msDS-DelegatedManagedServiceAccount",
          "inheritance": "Descendents",
          "accessType": "Allow",
          "labUnsafe": true
        },
        {
          "id": "existing-dmsa-state-inherited",
          "description": "Applied before dMSA creation and inherited only by dMSA descendants",
          "trustee": "DMSALAB\\Reaper-Existing",
          "target": "OU=ExistingDMSA,OU=Lab",
          "rights": [
            "WriteProperty"
          ],
          "objectType": "msDS-DelegatedMSAState",
          "inheritedObjectType": "msDS-DelegatedManagedServiceAccount",
          "inheritance": "Descendents",
          "accessType": "Allow",
          "labUnsafe": true
        },
        {
          "id": "existing-target-link",
